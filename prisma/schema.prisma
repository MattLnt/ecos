generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  nickname        String?
  number          Int?
  position        String?
  photo           String?  @db.Text
  avatar          String
  nbaTeam         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  sessionPlayers  SessionPlayer[]
}

model Court {
  id          String   @id @default(cuid())
  name        String
  spotsConfig Json
  isDefault   Boolean  @default(false)  // ← Ajoute cette ligne
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  sessions    Session[]
}

model Session {
  id          String   @id @default(cuid())
  courtId     String
  court       Court    @relation(fields: [courtId], references: [id])
  date        DateTime @default(now())  // Date de la session
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  status      String   @default("active") // active, completed
  
  sessionPlayers SessionPlayer[]
}

model SessionPlayer {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id])
  totalPoints Int      @default(0)
  rank        Int?

  // Groupe de tir ("A", "B", "C"…). Un entraînement à 11 joueurs se joue sur
  // plusieurs paniers en parallèle : chaque groupe avance à son rythme dans les
  // spots, mais tout le monde reste dans la même session, donc un seul
  // classement général. `null` = sessions d'avant la répartition par groupes.
  group       String?

  // Ordre de passage dans le groupe, tiré au sort à la création. Il est
  // persisté : un rechargement de la page ne doit pas rebattre les cartes au
  // milieu de l'entraînement.
  shootOrder  Int      @default(0)
  
  spotResults SpotResult[]
  
  @@unique([sessionId, playerId])
}

model SpotResult {
  id              String        @id @default(cuid())
  sessionPlayerId String
  sessionPlayer   SessionPlayer @relation(fields: [sessionPlayerId], references: [id], onDelete: Cascade)
  spotNum         Int           // 1-10
  spotLabel       String        // "45° MID", "FACE 3PTS"
  spotSub         String        // "DROITE", "GAUCHE", "CENTRE"
  makes           Int           // 0-10
  ftMakes         Int           // 0-2
  points          Int           // makes * ftMakes
  createdAt       DateTime      @default(now())

  // Heure réelle de la saisie sur le terrain, envoyée par l'appareil.
  //
  // `createdAt` est l'heure d'arrivée au serveur : depuis que les saisies
  // passent par une file rejouée au retour du réseau, les deux peuvent être
  // très éloignées, et une séance saisie hors ligne puis envoyée d'un coup
  // paraîtrait avoir duré quelques secondes.
  recordedAt      DateTime      @default(now())

  // Un spot n'est tiré qu'une fois par joueur et par session. Sans cette
  // contrainte, un double appui ou un retour arrière créait une seconde ligne
  // et les stats cumulaient les deux (« 10/20 tirs »).
  @@unique([sessionPlayerId, spotNum])
}